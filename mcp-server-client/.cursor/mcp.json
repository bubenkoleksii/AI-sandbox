{
  "mcpServers": {
    "sandbox-server": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/build/server.js"
      ],
      "cwd": "${workspaceFolder}",
      "dev": {
        "watch": "build/**/*.js",
        "debug": {
          "type": "node"
        }
      }
    }
  }
}
